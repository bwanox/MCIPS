PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000,http://127.0.0.1:3000
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1
AI_SERVICE_TOKEN=<shared-ai-service-token-32-plus-chars>
AGENT_API_URL=http://127.0.0.1:4100
AGENT_API_TOKEN=<shared-agent-api-token-32-plus-chars>
JWT_SECRET=<random-jwt-secret-32-plus-chars>
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=<admin-email>
ADMIN_TENANT_ID=<tenant-id>
ADMIN_PASSWORD_HASH=<bcrypt-password-hash>
MONGODB_URI=mongodb://127.0.0.1:27017/mcips
USE_IN_MEMORY_DB=true
STORE_RAW_CONTENT=false
COLLECTOR_KEY_PEPPER=<collector-hmac-pepper-32-plus-chars>
BOOTSTRAP_COLLECTOR_KEY=<bootstrap-collector-key-32-plus-chars>
BOOTSTRAP_COLLECTOR_TENANT_ID=<tenant-id>
BOOTSTRAP_COLLECTOR_ADAPTER=go-agent
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
