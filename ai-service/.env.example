APP_NAME=MCIPS AI Service
APP_ENV=development
API_PREFIX=/api/v1
AI_PROVIDER_MODE=fallback
SERVICE_API_TOKEN=<shared-ai-service-token-32-plus-chars>
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
THREAT_MODEL_PATH=model-artifacts/threat-classifier/model.pkl
ENABLE_LLM=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2:3b-instruct-q4_K_M
OPENROUTER_API_KEY=<optional-openrouter-key>
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
